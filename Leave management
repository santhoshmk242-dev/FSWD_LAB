import React, { useState } from "react";
import "./App.css";

function App() {
  const [leaves, setLeaves] = useState([]);

  const [form, setForm] = useState({
    name: "",
    type: "Casual Leave",
    from: "",
    to: "",
    reason: ""
  });

  // Handle input
  const handleChange = (e) => {
    setForm({
      ...form,
      [e.target.name]: e.target.value
    });
  };

  // Apply for leave
  const applyLeave = (e) => {
    e.preventDefault();

    if (form.to < form.from) {
      alert("End date cannot be before start date");
      return;
    }

    const newLeave = {
      ...form,
      id: Date.now(),
      status: "Pending"
    };

    setLeaves([...leaves, newLeave]);

    setForm({
      name: "",
      type: "Casual Leave",
      from: "",
      to: "",
      reason: ""
    });

    alert("Leave application submitted successfully!");
  };

  // Update leave status
  const updateStatus = (id, status) => {
    setLeaves(
      leaves.map((leave) =>
        leave.id === id
          ? { ...leave, status }
          : leave
      )
    );
  };

  // Delete leave request
  const deleteLeave = (id) => {
    setLeaves(
      leaves.filter((leave) => leave.id !== id)
    );
  };

  return (
    <div className="app">
      <header>
        <h1>Leave Management System</h1>
        <p>Manage employee leave applications easily</p>
      </header>

      <div className="dashboard">
        <div className="card">
          <h3>Total Requests</h3>
          <h2>{leaves.length}</h2>
        </div>

        <div className="card">
          <h3>Pending</h3>
          <h2>
            {leaves.filter(
              (l) => l.status === "Pending"
            ).length}
          </h2>
        </div>

        <div className="card">
          <h3>Approved</h3>
          <h2>
            {leaves.filter(
              (l) => l.status === "Approved"
            ).length}
          </h2>
        </div>

        <div className="card">
          <h3>Rejected</h3>
          <h2>
            {leaves.filter(
              (l) => l.status === "Rejected"
            ).length}
          </h2>
        </div>
      </div>

      <section className="form-section">
        <h2>Apply for Leave</h2>

        <form onSubmit={applyLeave}>
          <label>Employee Name</label>
          <input
            type="text"
            name="name"
            placeholder="Enter employee name"
            value={form.name}
            onChange={handleChange}
            required
          />

          <label>Leave Type</label>
          <select
            name="type"
            value={form.type}
            onChange={handleChange}
          >
            <option>Casual Leave</option>
            <option>Sick Leave</option>
            <option>Earned Leave</option>
            <option>Personal Leave</option>
          </select>

          <label>From Date</label>
          <input
            type="date"
            name="from"
            value={form.from}
            onChange={handleChange}
            required
          />

          <label>To Date</label>
          <input
            type="date"
            name="to"
            value={form.to}
            onChange={handleChange}
            min={form.from || undefined}
            required
          />

          <label>Reason</label>
          <textarea
            name="reason"
            placeholder="Enter reason for leave"
            value={form.reason}
            onChange={handleChange}
            required
          />

          <button type="submit">
            Submit Application
          </button>
        </form>
      </section>

      <section className="table-section">
        <h2>Leave Applications</h2>

        {leaves.length === 0 ? (
          <p>No leave applications available.</p>
        ) : (
          <div className="table-container">
            <table>
              <thead>
                <tr>
                  <th>Employee</th>
                  <th>Leave Type</th>
                  <th>From</th>
                  <th>To</th>
                  <th>Reason</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>

              <tbody>
                {leaves.map((leave) => (
                  <tr key={leave.id}>
                    <td>{leave.name}</td>
                    <td>{leave.type}</td>
                    <td>{leave.from}</td>
                    <td>{leave.to}</td>
                    <td>{leave.reason}</td>
                    <td>
                      <span
                        className={
                          "status " +
                          leave.status.toLowerCase()
                        }
                      >
                        {leave.status}
                      </span>
                    </td>
                    <td>
                      {leave.status === "Pending" && (
                        <>
                          <button
                            className="approve"
                            onClick={() =>
                              updateStatus(
                                leave.id,
                                "Approved"
                              )
                            }
                          >
                            Approve
                          </button>

                          <button
                            className="reject"
                            onClick={() =>
                              updateStatus(
                                leave.id,
                                "Rejected"
                              )
                            }
                          >
                            Reject
                          </button>
                        </>
                      )}

                      <button
                        className="delete"
                        onClick={() =>
                          deleteLeave(leave.id)
                        }
                      >
                        Delete
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </div>
  );
}

export default App;

